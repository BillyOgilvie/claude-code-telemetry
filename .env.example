# Copy to .env to override. Every value is optional; defaults are shown.

# Host ports. Change one if it clashes with something already running.
GRAFANA_PORT=3300
OTLP_HTTP_PORT=4318

# 127.0.0.1 = reachable from this machine only (safe default).
# 0.0.0.0 = reachable from your network. OTLP has no authentication: trusted networks only.
GRAFANA_BIND=127.0.0.1
OTLP_BIND=127.0.0.1

# How long to keep metrics and logs. A month-to-date view needs at least 31d.
RETENTION=90d
